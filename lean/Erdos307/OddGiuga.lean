import Mathlib

/-!
# An odd Giuga sequence (kernel-checked)

A *Giuga sequence* (Borwein–Borwein–Borwein–Girgensohn, "Giuga's conjecture on primality", Amer. Math. Monthly
103 (1996) 40–50) is a finite increasing sequence of integers n₁ < … < nₘ with
  ∑ 1/nᵢ − ∏ 1/nᵢ ∈ ℕ.
Their open question 3 asks: "Find a Giuga sequence which consists of odd factors (or odd primes) only, or prove
that none exist. If there were none, then Giuga's conjecture would be proved."

The 26 odd integers below form such a sequence, with value 1. They were found on 2026-11-25 by the residue-steered
descent (seed {3,5,…,23}, final step D' = −1) and are written out in full (largest: 351,997 digits).
Each also divides the product of the others minus 1 (an equivalent form, BBBG Theorem 1).
-/

namespace GiugaOdd

set_option maxRecDepth 1000000

/-- The 26 odd numbers, in increasing order. -/
def sol : List ℕ := [
  3,
  5,
  7,
  11,
  13,
  17,
  19,
  23,
  961,
  293771,
  96502889941,
  9182383773491810569087,
  4280935572762634103989167626931807222484097,
  1967326254100152335663618411108382548491687895539473557920634727690579784074316819733741,
  532551342415148474701170835974407789092253816992412449668044079004954076505913157227434233302465718586621804093701057541825106614822707732651982985514926354614141016803871,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  
]

/-- The integer form: the sum of the products of all-but-one is one more than the full product. -/
theorem sol_identity :
    (∑ x ∈ sol.toFinset, ∏ y ∈ sol.toFinset.erase x, y) = ∏ y ∈ sol.toFinset, y + 1 := by
  decide +kernel

/-- **An odd Giuga sequence**: 26 distinct odd integers > 1 whose reciprocals sum to 1 + 1/(their product). -/
theorem odd_giuga_sequence :
    ∃ S : Finset ℕ, S.card = 26 ∧ (∀ x ∈ S, Odd x ∧ 1 < x) ∧
      (∀ x ∈ S, x ∣ (∏ y ∈ S.erase x, y) - 1) ∧
      ∃ v : ℕ, 0 < v ∧ (∑ x ∈ S, (x : ℚ)⁻¹) - (∏ x ∈ S, (x : ℚ))⁻¹ = v := by
  refine ⟨sol.toFinset, ?_, ?_, ?_, 1, one_pos, ?_⟩
  · decide +kernel
  · intro x hx
    have h : ∀ x ∈ sol, x % 2 = 1 ∧ 1 < x := by decide +kernel
    obtain ⟨h1, h2⟩ := h x (List.mem_toFinset.mp hx)
    exact ⟨Nat.odd_iff.mpr h1, h2⟩
  · have h : ∀ x ∈ sol.toFinset, ((∏ y ∈ sol.toFinset.erase x, y) - 1) % x = 0 := by decide +kernel
    intro x hx
    exact Nat.dvd_of_mod_eq_zero (h x hx)
  · set S := sol.toFinset with hS
    have hpos : ∀ x ∈ S, (0 : ℚ) < x := by
      have h : ∀ x ∈ sol, 0 < x := by decide +kernel
      intro x hx; exact_mod_cast h x (List.mem_toFinset.mp hx)
    have hN : (0 : ℚ) < ∏ x ∈ S, (x : ℚ) := Finset.prod_pos hpos
    have hinv : ∀ x ∈ S, (x : ℚ)⁻¹ = (∏ y ∈ S.erase x, (y : ℚ)) / ∏ y ∈ S, (y : ℚ) := by
      intro x hx
      rw [← Finset.mul_prod_erase S (fun y => (y : ℚ)) hx]
      have hx0 : (x : ℚ) ≠ 0 := (hpos x hx).ne'
      have he : (∏ y ∈ S.erase x, (y : ℚ)) ≠ 0 :=
        (Finset.prod_pos fun y hy => hpos y (Finset.mem_of_mem_erase hy)).ne'
      field_simp
    rw [Finset.sum_congr rfl hinv, ← Finset.sum_div]
    have hid : (∑ x ∈ S, ∏ y ∈ S.erase x, (y : ℚ)) = (∏ y ∈ S, (y : ℚ)) + 1 := by
      have := congrArg (fun n : ℕ => (n : ℚ)) sol_identity
      push_cast at this
      exact this
    rw [hid, add_div, div_self hN.ne', one_div]
    push_cast
    ring

end GiugaOdd
